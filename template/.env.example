# Copy this file to .env and set the values of this machine; make reads .env, and a value on the command line wins.
# PORT=/dev/ttyUSB0
# BAUD={{ serial_baud }}
{%- if platform == 'stm32' and stm32_toolchain == 'rust' %}
# A port that refuses parity, such as a device bridge pty, needs STM32_SERIAL_MODE=8n1.
# STM32_SERIAL_MODE=8e1
{%- endif %}
# A device bridge pty:
# PORT=/run/devices/tty-<vid>-<pid>
