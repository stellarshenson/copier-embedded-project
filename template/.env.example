# Serial settings of this machine. Copy this file to .env and remove the leading "# " of each
# value you set; make reads .env, and a value on the command line wins (make upload PORT=...).
{%- if 'agents' in components %}
# Board facts (console baud and format, upload path): .agents/skills/{{ repo_name }}-device/SKILL.md
{%- endif %}
{%- if 'references' in components %}
# A device's port and serial settings: the Connection section of references/devices/<device>.md
{%- endif %}

# PORT - the serial port of the board; ls /dev/ttyUSB* /dev/ttyACM* lists the ports.
#   /dev/ttyUSB0 - a USB-serial adapter (CH340, CP210x, FTDI)
#   /dev/ttyACM0 - a USB CDC ACM device: a board with native USB, an Uno (ATmega16U2), an ST-Link
# PORT=/dev/ttyUSB0
# A device bridge pty, one per port granted in the browser, under /run/devices, or under
# /tmp/jupyterlab-device-<uid> when /run/devices is not writable:
# PORT=/run/devices/tty-<vid>-<pid>

# BAUD - the baud rate of make monitor{% if host_side == 'Yes' %} and make host-run{% endif %}{% if platform == 'stm32' and stm32_toolchain == 'rust' %} and of the stm32flash upload{% endif %};
#   the firmware console runs at {{ serial_baud }}.
# BAUD={{ serial_baud }}
{%- if platform == 'stm32' and stm32_toolchain == 'rust' %}

# STM32_SERIAL_MODE - the stm32flash serial mode: data bits, parity (n none, e even, o odd), stop
# bits. The STM32 ROM bootloader speaks 8 data bits, even parity, 1 stop bit (ST AN3155);
# make upload passes the mode to stm32flash -m.
#   8e1 - a direct USB-serial adapter: the port carries the even parity
#   8n1 - a port that refuses parity, such as a device bridge pty: the bridge's port record,
#         set to STM32 bootloader (115200 8E1), sets the parity on the wire
# STM32_SERIAL_MODE=8e1
{%- endif %}
