{% if esp_framework == 'espidf' %}
# ESP-IDF defaults of the starter firmware. PlatformIO regenerates sdkconfig from this file.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
{% elif esp_framework == 'esp8266-rtos-sdk' %}
# ESP8266 RTOS SDK defaults of the starter firmware. PlatformIO regenerates sdkconfig from this file.
{% endif %}
